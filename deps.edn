{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        ;; Provides datomic.client.api. Swap for/add com.datomic/client-pro or
        ;; com.datomic/client-cloud to replicate from those deployments.
        com.datomic/local {:mvn/version "1.0.291"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1048"}
        org.postgresql/postgresql {:mvn/version "42.7.8"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        org.clojure/tools.logging {:mvn/version "1.3.0"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}}}
